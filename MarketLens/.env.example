# Required by the SEC: identify yourself with a name and email.
SEC_USER_AGENT=Mona Hatami mona.hatamiai@gmail.com

# PostgreSQL connection. Use the password you set when installing PostgreSQL 18.
# If the password has special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
# The "marketlens" database is created automatically on first run.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/marketlens
